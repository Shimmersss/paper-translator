# Copy to .env (repo root) and fill in. Real environment variables override this file.

# --- PDF translation (BabelDOC) -------------------------------------------
# Any OpenAI-compatible chat completions endpoint: OpenAI, DeepSeek, Qwen,
# a local vLLM/Ollama server, etc.
BABELDOC_OPENAI_BASE_URL=https://api.openai.com/v1
BABELDOC_OPENAI_API_KEY=
BABELDOC_OPENAI_MODEL=gpt-4o-mini

# --- Image translation (vision model) -------------------------------------
# OpenAI-compatible or Anthropic Messages API. Leave the key empty to disable.
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional: use a different model for images only.
LLM_VISION_MODEL=
# auto | openai | claude  (auto picks claude when the URL contains "anthropic")
LLM_PROTOCOL=auto

# --- Server ----------------------------------------------------------------
# There are no accounts. Keep 127.0.0.1 unless an authenticating reverse proxy
# sits in front; anyone who can reach the port can spend your API quota.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
TRANSLATION_STORAGE_DIR=./data/translation-tasks
TRANSLATION_MAX_HISTORY=20
